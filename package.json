{
  "name": "knowledge_graph",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "check": "node scripts/check.mjs",
    "predev": "node scripts/contract-check.mjs --quiet",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "agent": "node scripts/agent.mjs",
    "agent:offline": "node scripts/agent.mjs --offline",
    "agent:reset": "node scripts/agent.mjs --reset --offline",
    "contract:check": "node scripts/contract-check.mjs",
    "contract:seal": "node scripts/contract-seal.mjs",
    "lint": "oxlint"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=20"
  }
