# 이미지에 들어가면 안 되는 것과, 들어가 봐야 쓸모없는 것.
#
# 맨 위 세 줄이 제일 중요하다. .env 가 이미지에 박히면 이미지를 받은 사람이
# 키를 그대로 갖게 된다. 배포에서 키는 호스트의 환경변수로만 넣는다.
.env
.env.*
!.env.example

# 호스트에서 만든 파이썬 가상환경. 이미지 안에서 리눅스용으로 다시 만든다.
.venv/
__pycache__/
*.pyc

# 이미지 안에서 npm ci 로 다시 깐다. macOS/Windows 에서 만든 게 섞이면 안 된다.
node_modules/

# 로컬 실행이 만든 그래프 상태. 배포본은 빈 상태에서 시작한다.
agent/state/

# 빌더 단계가 새로 만든다.
# output/ 은 여기 넣지 않는다 — 이름과 달리 산출물이 아니라 소스다.
# src/pdfNote.ts 가 output/pdf/*.pdf 를 빌드 타임에 import 한다.
dist/

.git/
.gitignore
.DS_Store
.vscode/
.idea/
*.log
